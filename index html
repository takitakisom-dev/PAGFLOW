<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Finanças 2026-2032</title>
<style>
:root{--bg:#0f111a;--card:#1a1d2e;--green:#7CFF6B;--text:#fff;--muted:#9aa0b8;--red:#ff7b7b}
*{box-sizing:border-box}body{margin:0;font-family:system-ui;background:var(--bg);color:var(--text);padding:16px}
h1{text-align:center}.card{background:var(--card);border-radius:18px;padding:14px;margin:12px 0;border-left:3px solid var(--green)}
.row{display:flex;justify-content:space-between;align-items:center}
input,select,button{width:100%;padding:12px;border-radius:10px;border:none;margin-top:8px;background:#23263d;color:#fff}
button{background:var(--green);color:#000;font-weight:800}
.tabs{display:flex;gap:6px;margin:10px 0;overflow:auto}
.tab{padding:8px 14px;background:#23263d;border-radius:20px;cursor:pointer;font-size:12px}
.tab.active{background:var(--green);color:#000;font-weight:800}
.small{font-size:12px;color:var(--muted)}
canvas{width:100%;height:180px;background:#15182a;border-radius:12px;margin-top:8px}
</style>
</head>
<body>
<h1>💰 Finanças 2026-2032</h1>
<div class="card"><div class="row"><b>Aluguel</b><span style="color:#7CFF6B">R$ 1.800,00</span></div><div class="small">Venc: 05/mês • Mensal</div></div>
<div class="card"><div class="row"><b>Cartão</b><span style="color:#7CFF6B">R$ 943,10</span></div><div class="small">Venc: 20/mês • Mensal</div></div>
<div class="card">
<b>Projeção 2026-2032</b>
<div class="tabs">
<div class="tab" onclick="setView('diario',this)">Diário</div>
<div class="tab" onclick="setView('semanal',this)">Semanal</div>
<div class="tab" onclick="setView('quinzenal',this)">Quinzenal</div>
<div class="tab active" onclick="setView('mensal',this)">Mensal</div>
<div class="tab" onclick="setView('anual',this)">Anual</div>
</div>
<canvas id="chart"></canvas>
<div class="small" id="resumo"></div>
</div>
<div class="card">
<b>➕ Adicionar</b>
<select id="tipo"><option>Água</option><option>Luz</option><option>Telefone</option><option>Internet</option><option>Gás</option><option>Mercado</option><option>Salário</option><option>Outro</option></select>
<input id="nome" placeholder="Nome ex: Vivo">
<input id="valor" type="number" placeholder="Valor R$">
<select id="freq"><option value="mensal">Mensal</option><option value="semanal">Semanal</option><option value="quinzenal">Quinzenal</option><option value="diario">Diário</option><option value="anual">Anual</option></select>
<button onclick="add()">Salvar</button>
<div id="lista" style="margin-top:10px"></div>
</div>
<script>
let view='mensal';
let contas=JSON.parse(localStorage.getItem('fin')||'[{"name":"Aluguel","valor":1800},{"name":"Cartão","valor":943.1}]');
function setView(v,el){view=v;document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));el.classList.add('active');calc();}
function add(){let n=document.getElementById('nome').value||document.getElementById('tipo').value;let v=parseFloat(document.getElementById('valor').value);if(!v)return alert('Valor?');contas.push({name:n,valor:v});localStorage.setItem('fin',JSON.stringify(contas));document.getElementById('valor').value='';render();calc();}
function render(){document.getElementById('lista').innerHTML=contas.map(c=>`<div class="row" style="padding:6px 0;border-bottom:1px solid #23263d"><span>${c.name}</span><span style="color:#7CFF6B">R$ ${c.valor.toFixed(2)}</span></div>`).join('');}
function calc(){let total=contas.reduce((s,c)=>s+c.valor,0);let f={diario:30,semanal:4.3,quinzenal:2,mensal:1,anual:1/12}[view];document.getElementById('resumo').innerText=`Visão ${view}: R$ ${(total*f).toFixed(2)} • Até 2032: R$ ${(total*12*7).toFixed(2)}`;}
render();calc();
</script>
</body>
</html>
